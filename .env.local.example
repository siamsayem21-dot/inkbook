# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — core
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — three separate webhook secrets (three registered endpoints in Stripe dashboard)
# 1. /api/billing/webhook  → subscription lifecycle (signup, upgrade, cancel) — InkBook's own platform account
# 2. /api/stripe/webhook   → deposit payments (booking deposits, custom request deposits) — platform account
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEPOSIT_WEBHOOK_SECRET=whsec_...
# 3. /api/stripe/connect-webhook → studio connected-account events (client deposit/remainder
#    payments once Stripe Connect is activated — see STRIPE_CONNECT_ENABLED below). Registered
#    in the Stripe Dashboard as a Connect endpoint ("Listen to events on Connected accounts"),
#    NOT an account endpoint — its signing secret is different from the two above.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Stripe Connect — subscription-only payment architecture (InkBook takes 0% of client
# deposit/remainder payments; those go directly to the studio's own connected Stripe account).
# Every Connect code path (onboarding route, connect-webhook, the Direct Charge branch in
# lib/stripe/deposit-checkout.ts, and the Owner Settings UI section) is gated behind this flag
# and is completely inert while it's unset/false. Do NOT set this to "true" in production until
# ALL of the following are done: this migration is applied
# (supabase/migrations/20260819000000_studios_stripe_connect.sql), Stripe Connect is enabled on
# the platform account in the Dashboard, and the connect-webhook endpoint above is registered.
# See TASKS.md NEEDS_SIAM for the exact activation checklist.
STRIPE_CONNECT_ENABLED=false

# Stripe — subscription price IDs (copy from Stripe dashboard → Products)
NEXT_PUBLIC_STRIPE_SOLO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_STUDIO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# Twilio (SMS reminders)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Resend (transactional email)
RESEND_API_KEY=re_...

# Anthropic (AI style detection, consultation questions, quote generation)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Cron job auth — set a long random secret and configure the same value in Vercel Cron
CRON_SECRET=your-long-random-secret-here

# App URL
# Local dev: http://localhost:3000
# Production (set in Vercel env vars): https://www.inkbook.tech
NEXT_PUBLIC_APP_URL=http://localhost:3000
