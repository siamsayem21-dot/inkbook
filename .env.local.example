# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — core
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — two separate webhook secrets (two registered endpoints in Stripe dashboard)
# 1. /api/billing/webhook  → subscription lifecycle (signup, upgrade, cancel)
STRIPE_WEBHOOK_SECRET=whsec_...
# 2. /api/stripe/webhook   → deposit payments (booking deposits, custom request deposits)
STRIPE_DEPOSIT_WEBHOOK_SECRET=whsec_...

# Stripe — subscription price IDs (copy from Stripe dashboard → Products)
NEXT_PUBLIC_STRIPE_SOLO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_STUDIO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# Twilio (SMS reminders)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Resend (transactional email)
RESEND_API_KEY=re_...

# Anthropic (AI style detection, consultation questions, quote generation)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Cron job auth — set a long random secret and configure the same value in Vercel Cron
CRON_SECRET=your-long-random-secret-here

# App URL
# Local dev: http://localhost:3000
# Production (set in Vercel env vars): https://www.inkbook.tech
NEXT_PUBLIC_APP_URL=http://localhost:3000
